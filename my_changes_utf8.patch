diff --git a/src/app/globals.css b/src/app/globals.css
index 80d10b2..bde0518 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -8,11 +8,1992 @@
   padding: 0;
 }
 
-html, body {
+html,
+body {
   background-color: #080809;
   color: #F5E4B5;
   font-family: 'Montserrat', sans-serif;
   overflow-x: hidden;
+  min-width: 360px;
+}
+
+/* Storefront shell: a lightweight, server-renderable Maison frame kept separate from cinematic routes. */
+.storefront-shell {
+  min-height: 100vh;
+  background: #f4efe7;
+  color: #211b17;
+  font-family: 'Montserrat', sans-serif;
+}
+
+.storefront-container {
+  width: min(100% - 2rem, 80rem);
+  margin-inline: auto;
+}
+
+.storefront-header {
+  position: sticky;
+  top: 0;
+  z-index: 50;
+  width: 100%;
+  border-bottom: 1px solid rgba(229, 193, 88, 0.15);
+  background: rgba(12, 10, 14, 0.28);
+  -webkit-backdrop-filter: blur(24px) saturate(180%);
+  backdrop-filter: blur(24px) saturate(180%);
+  box-shadow: 0 4px 30px rgba(0, 0, 0, 0.15);
+  transition: background-color 0.3s ease, border-color 0.3s ease, backdrop-filter 0.3s ease;
+}
+
+.storefront-header__inner {
+  min-height: 4.25rem;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1.5rem;
+}
+
+.storefront-brand {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.7rem;
+  color: #211b17;
+  text-decoration: none;
+}
+
+.storefront-brand__mark {
+  color: #9c7336;
+  font-size: 1.4rem;
+}
+
+.storefront-brand__name,
+.storefront-brand__descriptor {
+  display: block;
+}
+
+.storefront-brand__name {
+  font-family: 'Cormorant Garamond', Georgia, serif;
+  font-size: 1.8rem;
+  letter-spacing: 0.2em;
+  line-height: 0.9;
+}
+
+.storefront-brand__descriptor,
+.storefront-header__status,
+.storefront-footer__eyebrow {
+  color: #80643e;
+  font-size: 0.6rem;
+  letter-spacing: 0.2em;
+  text-transform: uppercase;
+}
+
+.storefront-primary-nav ul,
+.storefront-secondary-nav ul {
+  display: flex;
+  align-items: center;
+  gap: clamp(0.9rem, 1.7vw, 1.5rem);
+  list-style: none;
+}
+
+.storefront-primary-nav a,
+.storefront-secondary-nav a,
+.storefront-mega-trigger,
+.storefront-nav-item--planned {
+  position: relative;
+  display: inline-flex;
+  align-items: center;
+  height: 1.5rem;
+  padding: 0;
+  margin: 0;
+  color: rgba(245, 228, 181, 0.75);
+  font-family: 'Montserrat', sans-serif;
+  font-size: 0.68rem;
+  font-weight: 400;
+  line-height: 1;
+  letter-spacing: 0.12em;
+  text-decoration: none;
+  text-transform: uppercase;
+  white-space: nowrap;
+  background: transparent;
+  border: none;
+  cursor: pointer;
+  transition: color 180ms ease;
+}
+
+.storefront-secondary-nav a::after {
+  position: absolute;
+  right: 0;
+  bottom: -2px;
+  left: 0;
+  height: 1px;
+  background: #E5C158;
+  content: "";
+  transform: scaleX(0);
+  transform-origin: left;
+  transition: transform 200ms ease;
+}
+
+.storefront-primary-nav a::after,
+.storefront-mega-trigger::after,
+.storefront-nav-item--planned::after {
+  position: absolute;
+  right: 0;
+  bottom: -2px;
+  left: 0;
+  height: 1px;
+  background: #E5C158;
+  content: "";
+  transform: scaleX(0);
+  transform-origin: left;
+  transition: transform 200ms ease;
+}
+
+.storefront-primary-nav a:hover::after,
+.storefront-primary-nav a:focus-visible::after,
+.storefront-primary-nav a[aria-current="page"]::after,
+.storefront-secondary-nav a:hover::after,
+.storefront-secondary-nav a:focus-visible::after,
+.storefront-secondary-nav a[aria-current="page"]::after,
+.storefront-mega-trigger:hover::after,
+.storefront-mega-trigger:focus-visible::after,
+.storefront-mega-trigger[aria-expanded="true"]::after,
+.storefront-mega-trigger[aria-current="page"]::after,
+.storefront-nav-item--planned:hover::after {
+  transform: scaleX(1);
+}
+
+.storefront-primary-nav a:hover::after,
+.storefront-primary-nav a:focus-visible::after,
+.storefront-primary-nav a[aria-current="page"]::after,
+.storefront-secondary-nav a:hover::after,
+.storefront-secondary-nav a:focus-visible::after,
+.storefront-secondary-nav a[aria-current="page"]::after,
+.storefront-mega-trigger:hover::after,
+.storefront-mega-trigger:focus-visible::after,
+.storefront-mega-trigger[aria-expanded="true"]::after,
+.storefront-mega-trigger[aria-current="page"]::after,
+.storefront-nav-item--planned:hover::after {
+  transform: scaleX(1);
+}
+
+.storefront-primary-nav a:hover,
+.storefront-primary-nav a:focus-visible,
+.storefront-primary-nav a[aria-current="page"],
+.storefront-secondary-nav a:hover,
+.storefront-secondary-nav a:focus-visible,
+.storefront-secondary-nav a[aria-current="page"],
+.storefront-mega-trigger:hover,
+.storefront-mega-trigger:focus-visible,
+.storefront-mega-trigger[aria-expanded="true"],
+.storefront-mega-trigger[aria-current="page"] {
+  color: #ffdf78;
+}
+
+.storefront-nav-item--planned {
+  color: rgba(89, 74, 60, 0.45);
+  cursor: default;
+}
+
+.storefront-actions {
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+}
+
+.storefront-action {
+  position: relative;
+  display: inline-grid;
+  width: 2.1rem;
+  height: 2.1rem;
+  place-items: center;
+  border: 1px solid rgba(111, 78, 39, 0.2);
+  border-radius: 999px;
+  color: #80643e;
+  cursor: default;
+}
+
+.storefront-action__badge {
+  position: absolute;
+  top: -.28rem;
+  right: -.52rem;
+  display: grid;
+  width: 1rem;
+  height: 1rem;
+  place-items: center;
+  border-radius: 999px;
+  background: #d8b93f;
+  color: #17130d;
+  font: 700 .56rem/1 'Montserrat', sans-serif;
+}
+
+.storefront-action svg {
+  width: 1rem;
+  height: 1rem;
+  fill: none;
+  stroke: currentColor;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  stroke-width: 1.4;
+}
+
+.storefront-mega-nav {
+  position: relative;
+  display: flex;
+  align-items: center;
+}
+
+.storefront-mega-nav__triggers {
+  display: flex;
+  align-items: center;
+  gap: 1.35rem;
+}
+
+.storefront-mega-trigger {
+  position: relative;
+  border: 0;
+  background: transparent;
+  cursor: pointer;
+  font: inherit;
+  font-size: 0.68rem;
+  letter-spacing: 0.12em;
+  padding: 0;
+  margin: 0;
+  height: 1.5rem;
+  text-transform: uppercase;
+  white-space: nowrap;
+  display: inline-flex;
+  align-items: center;
+  gap: 0.22rem;
+  line-height: 1;
+}
+
+.storefront-mega-trigger span {
+  color: #d4af37;
+  display: inline-block;
+  margin-left: 0.2rem;
+  transform: translateY(-0.1rem);
+}
+
+.storefront-mega-trigger__chevron {
+  display: inline-block;
+  width: 0.52rem;
+  height: 0.35rem;
+  margin-left: 0.22rem;
+  vertical-align: middle;
+  fill: none;
+  stroke: currentColor;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  stroke-width: 1.8;
+  flex: 0 0 auto;
+  transition: transform 180ms ease, stroke 180ms ease, color 180ms ease;
+}
+
+.storefront-mega-trigger:hover .storefront-mega-trigger__chevron,
+.storefront-mega-trigger[aria-expanded="true"] .storefront-mega-trigger__chevron {
+  stroke: #ffdf78;
+  transform: rotate(180deg);
+}
+
+.storefront-mega-trigger:focus-visible {
+  outline: 2px solid #e5c158;
+  outline-offset: 0.3rem;
+}
+
+.storefront-mega-menu {
+  position: absolute;
+  top: calc(100% + 0.25rem);
+  left: -2rem;
+  z-index: 20;
+  display: grid;
